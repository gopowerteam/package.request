{
  "name": "@gopowerteam/request",
  "type": "module",
  "version": "0.5.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gopowerteam/package.request.git",
    "directory": "packages/request"
  },
  "keywords": [
    "gopowerteam",
    "request"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.mts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.mts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.cjs"
    },
    "./observable": {
      "types": "./dist/observable/generate-request-service.d.mts",
      "import": "./dist/observable/generate-request-service.mjs",
      "require": "./dist/observable/generate-request-service.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "adapters.d.ts",
    "dist",
    "plugins.d.ts"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "lint": "eslint . --fix"
  },
  "peerDependencies": {
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "1.21.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "rxjs": "7.8.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
