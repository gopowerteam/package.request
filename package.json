{
  "name": "request",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "turbo run build --filter '@gopowerteam/*'",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "pnpm -r --filter '@gopowerteam/*' exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "play:test": "pnpm dev --filter playground-test",
    "play:test-vite": "pnpm dev --filter playground-test-vite",
    "clear": "rimraf 'packages/*/{node_modules}' && rimraf node_modules",
    "changeset": "changeset",
    "clean": "rimraf node_modules **/*/node_modules",
    "cs:update": "changeset",
    "cs:version": "changeset version",
    "cs:tag": "changeset tag",
    "prerelease": "pnpm build",
    "release": "changeset publish --provenance",
    "prepare": "husky",
    "commit": "git-cz",
    "preinstall": "npx only-allow pnpm",
    "cs": "changeset && changeset version",
    "publish-packages": "turbo run build && changeset version && changeset publish --provenance",
    "docs:dev": "pnpm --filter request-docs run docs:dev",
    "docs:build": "pnpm --filter request-docs run docs:build"
  },
  "workspaces": [
    "playground/*",
    "packages/*"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "commitizen": "4.3.2",
    "cz-customizable": "7.5.4",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
